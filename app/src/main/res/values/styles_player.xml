<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Widget.Tempus.PlayerAction" parent="Widget.Material3.Button.TonalButton.Icon">
        <item name="android:layout_height">40dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textFontWeight" tools:targetApi="28">600</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="backgroundTint">@color/player_control_container</item>
        <item name="cornerRadius">20dp</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">8dp</item>
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.Tempus.PlayerQualityText" parent="">
        <item name="android:maxLines">1</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textFontWeight" tools:targetApi="28">600</item>
        <item name="android:letterSpacing">0.017</item>
    </style>

    <style name="Widget.Tempus.PlayerTitle" parent="HeadlineLarge">
        <item name="android:ellipsize">marquee</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textFontWeight" tools:targetApi="28">700</item>
        <item name="android:letterSpacing">-0.0125</item>
    </style>

    <style name="Widget.Tempus.PlayerArtist" parent="TitleMedium">
        <item name="android:ellipsize">marquee</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textFontWeight" tools:targetApi="28">500</item>
    </style>

    <style name="Widget.Tempus.PlayerTime" parent="">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textFontWeight" tools:targetApi="28">500</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
</resources>
