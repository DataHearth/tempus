<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/view_bottom_sheet_drag_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/song_cover_image_view"
                style="@style/BottomSheetHeaderCover" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/song_title_text_view"
                    style="@style/BottomSheetHeaderTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/label_placeholder" />

                <TextView
                    android:id="@+id/song_artist_text_view"
                    style="@style/BottomSheetHeaderSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/label_placeholder" />
            </LinearLayout>

            <ToggleButton
                android:id="@+id/button_favorite"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/button_favorite_inset"
                android:backgroundTint="@color/page_favorite_icon_tint"
                android:checked="false"
                android:contentDescription="@string/favorite_icon_description"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:text=""
                android:textOff=""
                android:textOn="" />
        </LinearLayout>

        <include
            android:id="@+id/song_asset_link_row"
            layout="@layout/view_asset_link_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="16dp" />

        <LinearLayout
            android:id="@+id/quick_action_layout"
            android:baselineAligned="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/bottom_sheet_tile_spacer"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:showDividers="middle">

            <TextView
                android:id="@+id/play_next_text_view"
                style="@style/BottomSheetTile"
                android:drawableTop="@drawable/ic_ms_playlist_play"
                android:text="@string/song_bottom_sheet_play_next" />

            <TextView
                android:id="@+id/add_to_queue_text_view"
                style="@style/BottomSheetTile"
                android:drawableTop="@drawable/ic_ms_queue_music"
                android:text="@string/song_bottom_sheet_add_to_queue" />

            <TextView
                android:id="@+id/add_to_playlist_text_view"
                style="@style/BottomSheetTile"
                android:drawableTop="@drawable/ic_ms_playlist_add"
                android:text="@string/song_bottom_sheet_add_to_playlist" />

            <TextView
                android:id="@+id/download_text_view"
                style="@style/BottomSheetTile"
                android:drawableTop="@drawable/ic_ms_download"
                android:text="@string/song_bottom_sheet_download" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/option_linear_layout"
            style="@style/BottomSheetActionGroups">

            <LinearLayout style="@style/BottomSheetActionGroup">

                <TextView
                    android:id="@+id/play_radio_text_view"
                    style="@style/BottomSheetActionRow"
                    android:drawableStart="@drawable/ic_ms_instant_mix"
                    android:text="@string/song_bottom_sheet_instant_mix" />

                <TextView
                    android:id="@+id/rate_text_view"
                    style="@style/BottomSheetActionRow"
                    android:drawableStart="@drawable/ic_ms_star"
                    android:text="@string/song_bottom_sheet_rate" />

                <TextView
                    android:id="@+id/go_to_album_text_view"
                    style="@style/BottomSheetActionRow"
                    android:drawableStart="@drawable/ic_ms_album"
                    android:text="@string/song_bottom_sheet_go_to_album" />

                <TextView
                    android:id="@+id/go_to_artist_text_view"
                    style="@style/BottomSheetActionRow"
                    android:drawableStart="@drawable/ic_ms_person"
                    android:text="@string/song_bottom_sheet_go_to_artist" />

                <TextView
                    android:id="@+id/share_text_view"
                    style="@style/BottomSheetActionRow"
                    android:drawableStart="@drawable/ic_ms_share"
                    android:text="@string/song_bottom_sheet_share"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/player_actions_group"
                style="@style/BottomSheetActionGroup"
                android:visibility="gone">

                <TextView
                    android:id="@+id/playback_speed_text_view"
                    style="@style/BottomSheetActionRow"
                    android:drawableStart="@drawable/ic_ms_speed"
                    android:text="@string/playback_speed_dialog_title"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/equalizer_text_view"
                    style="@style/BottomSheetActionRow"
                    android:drawableStart="@drawable/ic_graphic_eq"
                    android:text="@string/settings_app_equalizer"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/lan_playback_text_view"
                    style="@style/BottomSheetActionRow"
                    android:drawableStart="@drawable/ic_settings_cast"
                    android:text="@string/lan_play_on"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/remove_group"
                style="@style/BottomSheetActionGroup"
                android:visibility="gone">

                <TextView
                    android:id="@+id/remove_from_playlist_text_view"
                    style="@style/BottomSheetActionRow.Destructive"
                    android:drawableStart="@drawable/ic_ms_remove"
                    android:text="@string/song_bottom_sheet_remove_from_playlist"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/remove_text_view"
                    style="@style/BottomSheetActionRow.Destructive"
                    android:drawableStart="@drawable/ic_ms_delete"
                    android:text="@string/song_bottom_sheet_remove"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
