<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/view_bottom_sheet_drag_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="8dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/podcast_cover_image_view"
                style="@style/BottomSheetHeaderCover" />

            <TextView
                android:id="@+id/podcast_title_text_view"
                style="@style/BottomSheetHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:text="@string/label_placeholder" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/option_linear_layout"
            style="@style/BottomSheetActionGroups">

            <LinearLayout
                android:id="@+id/podcast_episode_action_group"
                style="@style/BottomSheetActionGroup">

                <TextView
                    android:id="@+id/play_next_text_view"
                    style="@style/BottomSheetActionRow"
                    android:drawableStart="@drawable/ic_skip_next"
                    android:text="@string/podcast_bottom_sheet_play_next"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/add_to_queue_text_view"
                    style="@style/BottomSheetActionRow"
                    android:drawableStart="@drawable/ic_queue"
                    android:text="@string/podcast_bottom_sheet_add_to_queue"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/download_text_view"
                    style="@style/BottomSheetActionRow"
                    android:drawableStart="@drawable/ic_download"
                    android:text="@string/podcast_bottom_sheet_download"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/go_to_channel_text_view"
                    style="@style/BottomSheetActionRow"
                    android:drawableStart="@drawable/ic_forward"
                    android:text="@string/podcast_bottom_sheet_go_to_channel"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout style="@style/BottomSheetActionGroup">

                <TextView
                    android:id="@+id/remove_text_view"
                    style="@style/BottomSheetActionRow.Destructive"
                    android:drawableStart="@drawable/ic_minus"
                    android:text="@string/podcast_bottom_sheet_remove"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/delete_text_view"
                    style="@style/BottomSheetActionRow.Destructive"
                    android:drawableStart="@drawable/ic_delete"
                    android:text="@string/podcast_bottom_sheet_delete" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
