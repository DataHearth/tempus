<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:minHeight="56dp"
    android:paddingStart="16dp"
    android:paddingEnd="4dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/internet_radio_station_cover_image_view"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Browse.RowCover" />

    <TextView
        android:id="@+id/internet_radio_station_title_text_view"
        style="@style/Browse.RowTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="@string/label_placeholder"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@id/internet_radio_station_subtitle_text_view"
        app:layout_constraintEnd_toStartOf="@+id/internet_radio_station_local_badge"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_goneMarginEnd="12dp"
        app:layout_constraintStart_toEndOf="@+id/internet_radio_station_cover_image_view"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/internet_radio_station_local_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_radio_local_badge"
        android:fontFamily="@font/inter_semi_bold"
        android:includeFontPadding="false"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:text="@string/radio_local_badge"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="11sp"
        android:visibility="gone"
        app:layout_constraintBaseline_toBaselineOf="@+id/internet_radio_station_title_text_view"
        app:layout_constraintEnd_toStartOf="@+id/internet_radio_station_play_button"
        app:layout_constraintStart_toEndOf="@+id/internet_radio_station_title_text_view" />

    <TextView
        android:id="@+id/internet_radio_station_subtitle_text_view"
        style="@style/Browse.RowSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:text="@string/label_placeholder"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/internet_radio_station_play_button"
        app:layout_constraintStart_toEndOf="@+id/internet_radio_station_cover_image_view"
        app:layout_constraintTop_toBottomOf="@+id/internet_radio_station_title_text_view" />

    <Button
        android:id="@+id/internet_radio_station_play_button"
        style="@style/Widget.Material3.Button.TonalButton.Icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/player_queue_play"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:padding="8dp"
        app:backgroundTint="?attr/colorSecondaryContainer"
        app:cornerRadius="20dp"
        app:icon="@drawable/ic_play"
        app:iconPadding="0dp"
        app:iconSize="24dp"
        app:iconTint="?attr/colorOnSecondaryContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/internet_radio_station_more_button"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/internet_radio_station_more_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/content_description_more_options"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_more_vert"
            app:tint="?attr/colorOnSurfaceVariant" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
