<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/view_bottom_sheet_drag_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/playlist_cover_image_view"
                style="@style/BottomSheetHeaderCover" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/playlist_title_text_view"
                    style="@style/BottomSheetHeaderTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/label_placeholder" />

                <TextView
                    android:id="@+id/playlist_count_text_view"
                    style="@style/BottomSheetHeaderSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/label_placeholder" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/option_linear_layout"
            style="@style/BottomSheetActionGroups">

            <LinearLayout style="@style/BottomSheetActionGroup">

                <TextView
                    android:id="@+id/play_row"
                    style="@style/BottomSheetActionRow"
                    android:drawableStart="@drawable/ic_ms_play_arrow"
                    android:text="@string/menu_go_to_playlist_button" />

                <TextView
                    android:id="@+id/play_shuffle_row"
                    style="@style/BottomSheetActionRow"
                    android:drawableStart="@drawable/ic_ms_shuffle"
                    android:text="@string/menu_play_shuffle_button" />

                <TextView
                    android:id="@+id/play_next_row"
                    style="@style/BottomSheetActionRow"
                    android:drawableStart="@drawable/ic_ms_playlist_play"
                    android:text="@string/song_bottom_sheet_play_next" />

                <TextView
                    android:id="@+id/add_to_queue_row"
                    style="@style/BottomSheetActionRow"
                    android:drawableStart="@drawable/ic_ms_queue_music"
                    android:text="@string/menu_add_to_queue_button" />
            </LinearLayout>

            <LinearLayout style="@style/BottomSheetActionGroup">

                <TextView
                    android:id="@+id/download_all_row"
                    style="@style/BottomSheetActionRow"
                    android:drawableStart="@drawable/ic_ms_download"
                    android:text="@string/menu_download_all_button" />

                <TextView
                    android:id="@+id/edit_playlist_row"
                    style="@style/BottomSheetActionRow"
                    android:drawableStart="@drawable/ic_ms_reorder"
                    android:text="@string/menu_edit_playlist_button" />

                <TextView
                    android:id="@+id/edit_playlist_details_row"
                    style="@style/BottomSheetActionRow"
                    android:drawableStart="@drawable/ic_ms_edit"
                    android:text="@string/menu_edit_playlist_details_button" />

                <TextView
                    android:id="@+id/pin_row"
                    style="@style/BottomSheetActionRow"
                    android:drawableStart="@drawable/ic_ms_keep"
                    android:text="@string/menu_pin_button" />

                <TextView
                    android:id="@+id/unpin_row"
                    style="@style/BottomSheetActionRow"
                    android:drawableStart="@drawable/ic_ms_keep"
                    android:text="@string/menu_unpin_button"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout style="@style/BottomSheetActionGroup">

                <TextView
                    android:id="@+id/delete_row"
                    style="@style/BottomSheetActionRow.Destructive"
                    android:drawableStart="@drawable/ic_ms_delete"
                    android:text="@string/playlist_editor_dialog_neutral_button" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
