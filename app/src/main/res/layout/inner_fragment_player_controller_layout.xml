<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/now_playing_media_controller_layout"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/player_media_quality_sector"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/player_collapse_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:padding="9dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_collapse"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_expand_more"
            app:tint="?attr/colorOnSurface" />

        <LinearLayout
            android:id="@+id/player_media_quality_sector_center"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_player_quality_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/player_media_extension"
                style="@style/Widget.Tempus.PlayerQualityText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/player_unknown_format" />

            <TextView
                android:id="@+id/player_media_bitrate"
                style="@style/Widget.Tempus.PlayerQualityText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <Button
            android:id="@+id/player_playback_speed_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurface"
            android:visibility="gone"
            app:cornerRadius="24dp"
            app:layout_constraintEnd_toStartOf="@+id/player_info_track"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageButton
            android:id="@+id/player_info_track"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_info_stream"
            app:tint="?attr/colorOnSurfaceVariant" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        android:id="@+id/player_asset_link_row"
        layout="@layout/view_asset_link_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/player_media_quality_sector" />

    <!-- The cover page pads the art by 24dp a side, so 412:340 gives the 340dp square of a
         412dp-wide phone and shrinks it on narrower ones. -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/player_media_cover_view_pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        app:layout_constraintDimensionRatio="H,412:340"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="340dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/player_asset_link_row" />

    <LinearLayout
        android:id="@+id/rating_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:scaleX="0.8"
        android:scaleY="0.8"
        app:layout_constraintBottom_toTopOf="@+id/player_title_row"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/player_media_cover_view_pager"
        app:layout_constraintVertical_chainStyle="spread">

        <RatingBar
            android:id="@+id/song_rating_bar"
            style="?android:attr/ratingBarStyleIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="1"
            android:rating="0"
            android:isIndicator="false" />

        <TextView
            android:id="@+id/rating_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:text=""/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/player_title_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/player_progress_block"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rating_container">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/player_media_title_label"
                style="@style/Widget.Tempus.PlayerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_placeholder" />

            <TextView
                android:id="@+id/player_artist_name_label"
                style="@style/Widget.Tempus.PlayerArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/label_placeholder" />

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatToggleButton
            android:id="@+id/button_favorite"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/button_favorite_player"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:checked="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text=""
            android:textOff=""
            android:textOn="" />

        <ImageButton
            android:id="@+id/player_overflow_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_description_more_options"
            android:src="@drawable/ic_more_vert"
            app:tint="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/player_progress_block"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/player_transport_row"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/player_title_row">

        <!-- DefaultTimeBar insets its bar by half the largest scrubber (10dp), so the bar runs at 24dp. -->
        <androidx.media3.ui.DefaultTimeBar
            android:id="@id/exo_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            app:bar_height="4dp"
            app:scrubber_enabled_size="16dp"
            app:scrubber_dragged_size="20dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="1dp">

            <com.eddyizm.tempus.ui.components.PlayerTimeTextView
                android:id="@+id/exo_position"
                style="@style/Widget.Tempus.PlayerTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:text="@string/label_placeholder" />

            <com.eddyizm.tempus.ui.components.PlayerTimeTextView
                android:id="@+id/exo_duration"
                style="@style/Widget.Tempus.PlayerTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="@string/label_placeholder" />

        </FrameLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/player_transport_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/player_quick_action_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/player_progress_block">

        <ImageButton
            android:id="@+id/exo_shuffle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_shuffle"
            app:tint="?attr/colorOnSurfaceVariant" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp">

            <ImageButton
                android:id="@+id/exo_prev"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="9dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_skip_previous"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/exo_rew"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_replay"
                app:tint="?attr/colorOnSurface" />

        </FrameLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@id/exo_play_pause"
            style="@style/ExoStyledControls.Button.Center.PlayPause"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="0dp"
            android:padding="16dp"
            android:background="@drawable/bg_player_play_button"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            app:tint="?attr/colorSurface" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp">

            <ImageButton
                android:id="@+id/exo_next"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="9dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_skip_next"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/exo_ffwd"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_forward"
                app:tint="?attr/colorOnSurface" />

        </FrameLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageButton
                android:id="@+id/exo_repeat_toggle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_repeat"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ToggleButton
                android:id="@+id/player_skip_silence_toggle_button"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:background="@drawable/button_skip_silence_selector"
                android:text=""
                android:textOff=""
                android:textOn="" />

        </FrameLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/player_quick_action_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/player_transport_row">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/player_sleep_timer_button"
            style="@style/Widget.Tempus.PlayerAction"
            android:layout_width="wrap_content"
            android:text="@string/player_action_timer"
            app:icon="@drawable/ic_bedtime" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/player_open_lyrics_button"
            style="@style/Widget.Tempus.PlayerAction"
            android:layout_width="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/player_action_lyrics"
            app:icon="@drawable/ic_lyrics_note" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/player_open_queue_button"
            style="@style/Widget.Tempus.PlayerAction"
            android:layout_width="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/player_action_queue"
            app:icon="@drawable/ic_queue" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
