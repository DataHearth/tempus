<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/album_info_sector"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="4dp"
    app:layout_scrollFlags="scroll|exitUntilCollapsed">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/album_cover_image_view"
        android:layout_width="216dp"
        android:layout_height="216dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:elevation="12dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Cover" />

    <TextView
        android:id="@+id/album_name_label"
        style="@style/HeadlineLarge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:letterSpacing="-0.02"
        android:maxLines="3"
        android:paddingTop="12dp"
        android:textColor="?attr/colorOnSurface"
        tools:text="@string/label_placeholder" />

    <LinearLayout
        android:id="@+id/album_artist_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="4dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/album_artist_image_view"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircleShapeAppearance" />

        <TextView
            android:id="@+id/album_artist_label"
            style="@style/LabelMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface"
            android:textFontWeight="700"
            tools:text="@string/label_placeholder" />
    </LinearLayout>

    <TextView
        android:id="@+id/album_meta_label"
        style="@style/LabelSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp"
        tools:text="Album · 2021 · 11 songs · 49 min" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="-12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_favorite"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:contentDescription="@string/favorite_icon_description"
            app:icon="@drawable/button_favorite_selector"
            app:iconTint="?attr/colorOnSurface" />

        <Button
            android:id="@+id/album_page_download_button"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/menu_download_label"
            app:icon="@drawable/ic_file_download" />

        <Button
            android:id="@+id/album_page_shuffle_button"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/album_page_shuffle_button"
            app:icon="@drawable/ic_shuffle" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/album_page_play_button"
            style="@style/Widget.App.Button.RoundPlay"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/album_page_play_button" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/album_detail_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        android:paddingBottom="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/album_genres_textview"
            style="@style/LabelSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="2dp"
            android:visibility="gone"
            tools:text="@string/label_placeholder"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/album_release_years_textview"
            style="@style/LabelSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="2dp"
            android:visibility="gone"
            tools:text="@string/label_placeholder"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/album_notes_textview"
            style="@style/LabelSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:justificationMode="inter_word"
            android:paddingTop="6dp"
            android:visibility="gone"
            tools:text="@string/label_placeholder"
            tools:visibility="visible" />
    </LinearLayout>
</LinearLayout>
