<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/now_playing_media_controller_layout"
    android:clickable="true"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/vertical_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.45" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/player_media_quality_sector"
        android:layout_width="0dp"
        android:layout_height="56dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/vertical_guideline"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/player_collapse_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:padding="9dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_collapse"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_expand_more"
            app:tint="?attr/colorOnSurface" />

        <Button
            android:id="@+id/player_playback_speed_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurface"
            android:visibility="gone"
            app:cornerRadius="24dp"
            app:layout_constraintEnd_toStartOf="@+id/player_info_track"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <LinearLayout
            android:id="@+id/player_media_quality_sector_center"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_player_quality_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/player_media_extension"
                style="@style/Widget.Tempus.PlayerQualityText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/player_unknown_format" />

            <TextView
                android:id="@+id/player_media_bitrate"
                style="@style/Widget.Tempus.PlayerQualityText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/player_info_track"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_info_stream"
            app:tint="?attr/colorOnSurfaceVariant" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/player_media_cover_view_pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="12dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/vertical_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/rating_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:scaleX="0.8"
        android:scaleY="0.8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/vertical_guideline"
        app:layout_constraintTop_toBottomOf="@+id/player_media_quality_sector">

        <RatingBar
            android:id="@+id/song_rating_bar"
            style="?android:attr/ratingBarStyleIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="1"
            android:rating="0"
            android:isIndicator="false" />

        <TextView
            android:id="@+id/rating_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:text=""/>
    </LinearLayout>

    <TextView
        android:id="@+id/player_media_title_label"
        style="@style/HeadlineLarge"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="4dp"
        android:ellipsize="marquee"
        android:singleLine="true"
        android:text="@string/label_placeholder"
        android:textColor="?attr/colorOnSurface"
        android:textFontWeight="700"
        android:textSize="24sp"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintBottom_toTopOf="@+id/player_artist_name_label"
        app:layout_constraintEnd_toStartOf="@+id/button_favorite"
        app:layout_constraintStart_toEndOf="@+id/vertical_guideline"
        app:layout_constraintTop_toBottomOf="@+id/player_media_quality_sector" />

    <TextView
        android:id="@+id/player_artist_name_label"
        style="@style/TitleMedium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="4dp"
        android:ellipsize="marquee"
        android:singleLine="true"
        android:text="@string/label_placeholder"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textFontWeight="500"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@+id/button_favorite"
        app:layout_constraintStart_toEndOf="@+id/vertical_guideline"
        app:layout_constraintTop_toBottomOf="@+id/player_media_title_label"
        app:layout_constraintBottom_toTopOf="@id/exo_progress"/>

    <androidx.appcompat.widget.AppCompatToggleButton
        android:id="@+id/button_favorite"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/button_favorite_player"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:checked="false"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text=""
        android:textOff=""
        android:textOn=""
        app:layout_constraintBottom_toBottomOf="@+id/player_artist_name_label"
        app:layout_constraintEnd_toStartOf="@id/player_overflow_button"
        app:layout_constraintTop_toTopOf="@+id/player_media_title_label" />

    <ImageButton
        android:id="@+id/player_overflow_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="12dp"
        android:padding="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/content_description_more_options"
        android:src="@drawable/ic_more_vert"
        app:layout_constraintBottom_toBottomOf="@+id/button_favorite"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/button_favorite"
        app:tint="?attr/colorOnSurfaceVariant" />

    <androidx.media3.ui.DefaultTimeBar
        android:id="@id/exo_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:bar_height="4dp"
        app:scrubber_enabled_size="16dp"
        app:scrubber_dragged_size="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/vertical_guideline"
        app:layout_constraintTop_toBottomOf="@+id/player_artist_name_label"
        app:layout_constraintBottom_toTopOf="@+id/player_play_pause_placeholder_view" />

    <com.eddyizm.tempus.ui.components.PlayerTimeTextView
        android:id="@+id/exo_position"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:text="@string/label_placeholder"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textFontWeight="500"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@+id/vertical_guideline"
        app:layout_constraintTop_toBottomOf="@+id/exo_progress" />

    <com.eddyizm.tempus.ui.components.PlayerTimeTextView
        android:id="@+id/exo_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:text="@string/label_placeholder"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textFontWeight="500"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/exo_progress" />

    <View
        android:id="@+id/placeholder_view_left"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/placeholder_view_middle_left"
        app:layout_constraintEnd_toStartOf="@+id/placeholder_view_middle_left"
        app:layout_constraintStart_toEndOf="@+id/vertical_guideline"
        app:layout_constraintTop_toTopOf="@+id/placeholder_view_middle_left" />

    <View
        android:id="@+id/placeholder_view_middle_left"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:layout_constraintBottom_toBottomOf="@+id/player_play_pause_placeholder_view"
        app:layout_constraintEnd_toStartOf="@+id/player_play_pause_placeholder_view"
        app:layout_constraintStart_toEndOf="@id/placeholder_view_left"
        app:layout_constraintTop_toTopOf="@+id/player_play_pause_placeholder_view" />

    <View
        android:id="@+id/player_play_pause_placeholder_view"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="28dp"
        app:layout_constraintBottom_toTopOf="@+id/player_quick_action_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/vertical_guideline"
        app:layout_constraintTop_toBottomOf="@+id/exo_progress"/>

    <View
        android:id="@+id/placeholder_view_middle_right"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:layout_constraintBottom_toBottomOf="@+id/player_play_pause_placeholder_view"
        app:layout_constraintEnd_toStartOf="@id/placeholder_view_right"
        app:layout_constraintStart_toEndOf="@+id/player_play_pause_placeholder_view"
        app:layout_constraintTop_toTopOf="@+id/player_play_pause_placeholder_view" />

    <View
        android:id="@+id/placeholder_view_right"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/placeholder_view_middle_right"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/placeholder_view_middle_right"
        app:layout_constraintTop_toTopOf="@+id/placeholder_view_middle_right" />

    <ImageButton
        android:id="@+id/exo_shuffle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/placeholder_view_left"
        app:layout_constraintEnd_toEndOf="@+id/placeholder_view_left"
        app:layout_constraintStart_toStartOf="@+id/placeholder_view_left"
        app:layout_constraintTop_toTopOf="@+id/placeholder_view_left"
        app:srcCompat="@drawable/ic_shuffle"
        app:tint="?attr/colorOnSurface" />

    <ImageButton
        android:id="@+id/exo_rew"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_replay"
        app:layout_constraintBottom_toBottomOf="@+id/placeholder_view_middle_left"
        app:layout_constraintEnd_toEndOf="@+id/placeholder_view_middle_left"
        app:layout_constraintStart_toStartOf="@+id/placeholder_view_middle_left"
        app:layout_constraintTop_toTopOf="@+id/placeholder_view_middle_left"
        app:tint="?attr/colorOnSurface" />

    <ImageButton
        android:id="@+id/exo_prev"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="9dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/placeholder_view_middle_left"
        app:layout_constraintEnd_toEndOf="@+id/placeholder_view_middle_left"
        app:layout_constraintStart_toStartOf="@+id/placeholder_view_middle_left"
        app:layout_constraintTop_toTopOf="@+id/placeholder_view_middle_left"
        app:srcCompat="@drawable/ic_skip_previous"
        app:tint="?attr/colorOnSurface" />

    <ImageButton
        android:id="@id/exo_play_pause"
        style="@style/ExoStyledControls.Button.Center.PlayPause"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="0dp"
        android:padding="16dp"
        android:background="@drawable/bg_player_play_button"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/player_play_pause_placeholder_view"
        app:layout_constraintEnd_toEndOf="@+id/player_play_pause_placeholder_view"
        app:layout_constraintStart_toStartOf="@+id/player_play_pause_placeholder_view"
        app:layout_constraintTop_toTopOf="@+id/player_play_pause_placeholder_view"
        app:tint="?attr/colorSurface" />

    <ImageButton
        android:id="@+id/exo_next"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="9dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/placeholder_view_middle_right"
        app:layout_constraintEnd_toEndOf="@+id/placeholder_view_middle_right"
        app:layout_constraintStart_toStartOf="@+id/placeholder_view_middle_right"
        app:layout_constraintTop_toTopOf="@+id/placeholder_view_middle_right"
        app:srcCompat="@drawable/ic_skip_next"
        app:tint="?attr/colorOnSurface" />

    <ImageButton
        android:id="@+id/exo_ffwd"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/placeholder_view_middle_right"
        app:layout_constraintEnd_toEndOf="@+id/placeholder_view_middle_right"
        app:layout_constraintStart_toStartOf="@+id/placeholder_view_middle_right"
        app:layout_constraintTop_toTopOf="@+id/placeholder_view_middle_right"
        app:srcCompat="@drawable/ic_forward"
        app:tint="?attr/colorOnSurface" />

    <ImageButton
        android:id="@+id/exo_repeat_toggle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/placeholder_view_right"
        app:layout_constraintEnd_toEndOf="@+id/placeholder_view_right"
        app:layout_constraintStart_toStartOf="@+id/placeholder_view_right"
        app:layout_constraintTop_toTopOf="@+id/placeholder_view_right"
        app:srcCompat="@drawable/ic_repeat"
        app:tint="?attr/colorOnSurface" />

    <ToggleButton
        android:id="@+id/player_skip_silence_toggle_button"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/button_skip_silence_selector"
        android:text=""
        android:textOff=""
        android:textOn=""
        app:layout_constraintBottom_toBottomOf="@+id/placeholder_view_right"
        app:layout_constraintEnd_toEndOf="@+id/placeholder_view_right"
        app:layout_constraintStart_toStartOf="@+id/placeholder_view_right"
        app:layout_constraintTop_toTopOf="@+id/placeholder_view_right" />

    <LinearLayout
        android:id="@+id/player_quick_action_view"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="0dp"
        android:layout_height="@dimen/_45sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/vertical_guideline"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/player_sleep_timer_button"
            style="@style/Widget.Tempus.PlayerAction"
            android:layout_width="wrap_content"
            android:text="@string/player_action_timer"
            app:icon="@drawable/ic_bedtime" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/player_open_lyrics_button"
            style="@style/Widget.Tempus.PlayerAction"
            android:layout_width="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/player_action_lyrics"
            app:icon="@drawable/ic_lyrics_note" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/player_open_queue_button"
            style="@style/Widget.Tempus.PlayerAction"
            android:layout_width="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/player_action_queue"
            app:icon="@drawable/ic_queue" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
