<?xml version="1.0" encoding="utf-8"?>
<!-- CompoundButton draws its button at the drawable's intrinsic size from the left edge,
     so the transparent 48dp item keeps the 28dp icon centred in the 48dp toggle. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="48dp"
        android:height="48dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item
        android:width="28dp"
        android:height="28dp"
        android:drawable="@drawable/button_play_pause_selector"
        android:gravity="center" />
</layer-list>
